  m_text: "\u0414\u0430, \u043C\u0430\u043B\u044B\u0448\u043A\u0430. \u042F \u043F\u043E\u0441\u043F\u043B\u044E
    \u0447\u0430\u0441\u0430 \u0434\u0432\u0430 \u0438 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0443.
    \u0421\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0435 \u0437\u0430\u0434\u0430\u043D\u0438\u0435
    \u0441\u0442\u043E\u0438\u0442 \u0448\u0442\u0443\u043A\u0443. \u041A\u043E\u0433\u0434\u0430
    \u0442\u044B \u0432\u0435\u0440\u043D\u0435\u0448\u044C\u0441\u044F \u0441 \u0440\u0430\u0431\u043E\u0442\u044B,
