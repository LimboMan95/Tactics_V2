  triggerAfterLevelIndex: 17
  pages:
  - frame0:
      sprite: {fileID: 21300000, guid: 33e159eaa76dba14797e09605b3a4674, type: 3}
      showTextPlate: 1
      frameText: "\u042D\u0442\u043E \u0431\u044B\u043B\u043E \u043F\u043E\u0442\u043D\u043E,
        \u043D\u043E \u044F \u0445\u043E\u0440\u043E\u0448!"
    frame1:
      sprite: {fileID: 21300000, guid: da76ffd369857f048bf37a75736a9bc5, type: 3}
      showTextPlate: 1
      frameText: "\u041D\u0438\u043A, \u043F\u0440\u0438\u0432\u0435\u0442... \u0421\u043B\u0443\u0448\u0430\u0439,
        \u0430 \u0447\u0435\u043C \u044D\u0442\u043E \u0443 \u043D\u0430\u0441 \u0432\u043E\u043D\u044F\u0435\u0442?
        \u041A\u0430\u043A\u043E\u0439-\u0442\u043E \u043C\u0435\u0440\u0437\u043A\u0438\u0439
        \u043E\u0434\u0435\u043A\u043E\u043B\u043E\u043D..."
    frame2:
      sprite: {fileID: 21300000, guid: 1e9c9c3a60b52194d8f3eb9b6dafc669, type: 3}
      showTextPlate: 1
      frameText: "\u0423\u0433\u0430\u0434\u0430\u0439 \u0441 \u0442\u0440\u0435\u0445
        \u0440\u0430\u0437, \u043C\u0438\u043B\u0430\u044F"
  - frame0:
      sprite: {fileID: 21300000, guid: dd122ff736e4ffb488b7cf42d894b07c, type: 3}
      showTextPlate: 1
      frameText: "\u0415\u0431\u0443\u0447\u0438\u0439 \u041F\u0430\u0442\u0440\u0438\u043A?
        \u041E\u043F\u044F\u0442\u044C \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u043B
        \u043F\u0438\u0442\u044C \u0438\u0437 \u0442\u0435\u0431\u044F \u043A\u0440\u043E\u0432\u044C?\n\u0414\u0430,
        \u043E\u043D. \u041D\u043E \u043F\u043B\u0435\u0432\u0430\u0442\u044C \u043D\u0430
        \u043D\u0435\u0433\u043E, \u0441\u043C\u043E\u0442\u0440\u0438. \u042F \u0437\u0430\u043A\u0440\u044B\u043B
        \u043A\u043E\u043D\u0442\u0440\u0430\u043A\u0442. \u041D\u0430 \u0441\u0447\u0435\u0442\u0443
        \u0434\u0432\u0435 \u0441\u0435\u043C\u044C\u0441\u043E\u0442 \u043F\u044F\u0442\u044C\u0434\u0435\u0441\u044F\u0442!
        \u041D\u0430\u043C \u043F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E
        \u0445\u0432\u0430\u0442\u0438\u0442 \u043D\u0430 \u043A\u0432\u0430\u0440\u0442\u0438\u0440\u0443,
        \u0435\u0449\u0435 \u0438 \u043D\u0430 \u043D\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u0443\u044E
        \u0436\u0438\u0437\u043D\u044C \u043E\u0441\u0442\u0430\u043D\u0435\u0442\u0441\u044F"
    frame1:
      sprite: {fileID: 21300000, guid: ecd3ab2b31fb9a2428b2cfd98395bc14, type: 3}
      showTextPlate: 1
      frameText: "\u0411\u043E\u0436\u0435, \u043E\u0442\u043B\u0438\u0447\u043D\u044B\u0435
        \u043D\u043E\u0432\u043E\u0441\u0442\u0438... \u0410 \u044F \u0432\u044B\u043F\u0440\u043E\u0441\u0438\u043B\u0430
        \u0430\u0432\u0430\u043D\u0441 \u0443 \u0412\u0438\u043A\u0442\u043E\u0440\u0430,
        \u0447\u0442\u043E\u0431\u044B \u043A\u0443\u043F\u0438\u0442\u044C \u0445\u043E\u0442\u044C
        \u044D\u0442\u043E\u0439 \u0435\u0434\u044B. \u042D\u0442\u043E\u0442 \u0443\u0440\u043E\u0434
        \u043E\u043F\u044F\u0442\u044C \u0437\u0432\u0430\u043B \u043C\u0435\u043D\u044F
        \u0432 \u0440\u0435\u0441\u0442\u043E\u0440\u0430\u043D, \u044F \u043E\u0442\u043A\u0430\u0437\u0430\u043B\u0430,
        \u043A\u0430\u043A \u043E\u0431\u044B\u0447\u043D\u043E, \u043D\u043E \u0434\u0435\u043D\u0435\u0433
        \u043E\u043D \u0432\u0441\u0451-\u0442\u0430\u043A\u0438 \u0434\u0430\u043B"
    frame2:
      sprite: {fileID: 21300000, guid: 7a840e40c95823f49be73cfd18159528, type: 3}
      showTextPlate: 1
      frameText: "\u041F\u043E\u0448\u0435\u043B \u043D\u0430\u0445\u0435\u0440 \u044D\u0442\u043E\u0442
        \u0442\u0432\u043E\u0439 \u0412\u0438\u043A\u0442\u043E\u0440. \u0422\u0435\u043F\u0435\u0440\u044C
        \u044F \u0441\u0430\u043C \u0431\u0443\u0434\u0443 \u0432\u043E\u0434\u0438\u0442\u044C
        \u0442\u0435\u0431\u044F \u043F\u043E \u0440\u0435\u0441\u0442\u043E\u0440\u0430\u043D\u0430\u043C.
        \u0418 \u041F\u0430\u0442\u0440\u0438\u043A \u0442\u0443\u0434\u0430 \u0436\u0435
        \u0441\u043E \u0441\u0432\u043E\u0438\u043C \u0434\u043E\u043B\u0433\u043E\u043C
        \u0432 12 \u0442\u044B\u0441\u044F\u0447 \u2014 \u0441 \u043D\u043E\u0432\u043E\u0439
        \u0440\u0430\u0431\u043E\u0442\u043E\u0439 \u044D\u0442\u043E \u0435\u0440\u0443\u043D\u0434\u0430.
        \u0418\u0434\u0438 \u0441\u044E\u0434\u0430... \u042F, \u043A\u0441\u0442\u0430\u0442\u0438,
        \u0434\u0430\u0436\u0435 \u043A\u0430\u0431\u0435\u043B\u044C\u043D\u043E\u0435
        \u043D\u0430\u043C \u043E\u043F\u043B\u0430\u0442\u0438\u043B"
  - frame0:
      sprite: {fileID: 21300000, guid: 71bc10e1445aa3a4c8ac23eeb1e89444, type: 3}
      showTextPlate: 1
      frameText: "\u0417\u043D\u0430\u0435\u0448\u044C \u0447\u0442\u043E... \u0422\u044B
        \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u0437\u0430\u0441\u043B\u0443\u0436\u0438\u043B
        \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E \u0442\u0435\u043B\u0435\u0432\u0438\u0434\u0435\u043D\u0438\u0435,
        \u043C\u0438\u043B\u044B\u0439"
    frame1:
      sprite: {fileID: 21300000, guid: 795ce4f6fa94f90469595d0d45d6ccb7, type: 3}
      showTextPlate: 0
      frameText: 
    frame2:
      sprite: {fileID: 21300000, guid: 7ffc934f887c11f449046ba6801ca9cf, type: 3}
      showTextPlate: 1
      frameText: "...\u0422\u0440\u0430\u0433\u0435\u0434\u0438\u044F \u0432 \u043F\u0440\u044F\u043C\u043E\u043C
        \u044D\u0444\u0438\u0440\u0435. \u0421\u0435\u0433\u043E\u0434\u043D\u044F
        \u0434\u043D\u0435\u043C \u0432\u043D\u0435\u0437\u0430\u043F\u043D\u043E
        \u0441\u043B\u0443\u0447\u0438\u043B\u0441\u044F \u0441\u0438\u0441\u0442\u0435\u043C\u043D\u044B\u0439
        \u0441\u0431\u043E\u0439 \u0432 \u0447\u0430\u0441\u0442\u043D\u043E\u0439
        \u044D\u043B\u0435\u043A\u0442\u0440\u043E-\u0441\u0430\u0443\u043D\u0435,
        \u0432 \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u0435 \u0447\u0435\u0433\u043E
        \u0432\u0438\u0446\u0435-\u043F\u0440\u0435\u0437\u0438\u0434\u0435\u043D\u0442
        \"\u0413\u043B\u043E\u0431\u0430\u043B \u0418\u043D\u0434\u0430\u0441\u0442\u0440\u0438\u0437\"
        \u0441\u043A\u043E\u043D\u0447\u0430\u043B\u0441\u044F, \u043D\u0435 \u0438\u043C\u0435\u044F
        \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u0438 \u0432\u044B\u0439\u0442\u0438
        \u0438\u0437 \u0437\u0430\u0431\u043B\u043E\u043A\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u043E\u0433\u043E
        \u043F\u043E\u043C\u0435\u0449\u0435\u043D\u0438\u044F..."
  - frame0:
      sprite: {fileID: 21300000, guid: 190e5e53850fb214bb1fff08ed99aad6, type: 3}
      showTextPlate: 1
      frameText: "...\u042D\u043A\u0441\u043F\u0435\u0440\u0442\u044B \u0443\u0434\u0438\u0432\u043B\u0435\u043D\u044B,
        \u0447\u0442\u043E \u0434\u0430\u043D\u043D\u044B\u0439 \u043D\u0435\u0441\u0447\u0430\u0441\u0442\u043D\u044B\u0439
        \u0441\u043B\u0443\u0447\u0430\u0439 \u043F\u0440\u043E\u0438\u0437\u043E\u0448\u0435\u043B
        \u043A\u0430\u043A \u0440\u0430\u0437 \u043D\u0430\u043A\u0430\u043D\u0443\u043D\u0435
        \u0435\u0433\u043E \u0437\u0430\u0432\u0442\u0440\u0430\u0448\u043D\u0435\u0433\u043E
        \u0432\u044B\u0441\u0442\u0443\u043F\u043B\u0435\u043D\u0438\u044F \u0441
        \u0433\u0440\u043E\u043C\u043A\u0438\u043C \u0437\u0430\u044F\u0432\u043B\u0435\u043D\u0438\u0435\u043C
        \u043E \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u0435 \u043A\u043E\u0440\u043F\u043E\u0440\u0430\u0442\u0438\u0432\u043D\u044B\u0445
        \u0441\u0435\u0442\u0435\u0439. \u041F\u043E\u0445\u043E\u0436\u0435, \u0442\u0435\u043F\u0435\u0440\u044C
        \u0440\u0435\u0437\u043E\u043D\u0430\u043D\u0441\u043D\u044B\u0439 \u0437\u0430\u043A\u043E\u043D\u043E\u043F\u0440\u043E\u0435\u043A\u0442
        \u0431\u0443\u0434\u0435\u0442 \u043F\u043E\u0441\u0442\u0430\u0432\u043B\u0435\u043D
        \u043D\u0430 \u043F\u0430\u0443\u0437\u0443..."
    frame1:
      sprite: {fileID: 21300000, guid: 6a990358295b9904fac173cd12860408, type: 3}
      showTextPlate: 1
      frameText: "\u042D\u043A\u0441\u043F\u0435\u0440\u0442\u044B \u0433\u043E\u0432\u043E\u0440\u044F\u0442
        \u043E \u0441\u0431\u043E\u0435 \u0432 \u0440\u0430\u0431\u043E\u0442\u0435
        \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u043B\u0435\u0440\u0430 \u043F\u0440\u043E\u0432\u043E\u0434\u043A\u0438,
        \u043D\u043E \u0440\u0430\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u0435
        \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0435\u0442\u0441\u044F..."
